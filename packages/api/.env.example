# Puerto en el que escucha el API (opcional, por defecto 3000).
PORT=3000

# Origen (URL) del frontend permitido (REQUERIDO, sin fallback).
# Usado por el middleware de CORS para restringir que solo este origen
# pueda consumir la API desde el navegador.
CORS_ORIGIN=http://localhost:5173

# Credenciales de la API de Imagga (REQUERIDAS, sin fallback).
IMAGGA_API_KEY=your_imagga_api_key
IMAGGA_API_SECRET=your_imagga_api_secret

# El idioma de los tags de Imagga es una constante de codigo
# (src/tagger/taggerConstants.ts -> IMAGGA_TAG_LANGUAGE), no una variable de
# entorno: no cambia por despliegue.

# Tamano maximo permitido para la imagen subida, en MB (opcional, por defecto 10).
MAX_FILE_SIZE_MB=10
