# URL del backend (REQUERIDO, sin fallback).
# Es el target del proxy de Vite en desarrollo: el navegador llama a /api y
# Vite lo reenvia a ${VITE_API_URL}, manteniendo el mismo origen (sin CORS).
# En produccion, enruta /api hacia este backend desde tu reverse proxy.
# Copia este archivo a `.env` para desarrollo local.
VITE_API_URL=http://localhost:3000
