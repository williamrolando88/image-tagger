# Variables para docker-compose. Copia este archivo a `.env` y completa los
# valores. NUNCA subas `.env` con claves reales al repositorio.
#
# (Para desarrollo local sin Docker, cada paquete tiene su propio .env.example:
#  packages/api/.env.example y packages/ui/.env.example.)

# Credenciales de la API de Imagga (REQUERIDAS). Se obtienen en https://imagga.com/.
IMAGGA_API_KEY=your_imagga_api_key
IMAGGA_API_SECRET=your_imagga_api_secret

# Tamano maximo permitido para la imagen subida, en MB (opcional, por defecto 10).
MAX_FILE_SIZE_MB=10
